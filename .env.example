# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
NEXT_PUBLIC_APP_URL=https://your-mini-app-domain.com

# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/fitmate

# Gemini - comma separated keys, rotated on 429 rate-limit errors
GEMINI_API_KEYS=key_one,key_two,key_three
GEMINI_MODEL=gemini-2.0-flash

# Cron reminder auth — set any random long string, and set the SAME value
# in your Vercel project's Environment Variables. Vercel's native Cron
# Jobs auto-send this as `Authorization: Bearer <value>` when they hit
# /api/cron/*. Also works for manual/GitHub Actions curl calls via the
# `x-cron-secret` header.
CRON_SECRET=replace-with-a-long-random-string
